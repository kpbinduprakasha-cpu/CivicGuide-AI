# CivicGuide AI - Environment Configuration Example

# Flask Backend Configuration
FLASK_APP=backend/run.py
FLASK_DEBUG=False
PORT=5000
SECRET_KEY=civicguide-secret-key-2026-secure-token
JWT_SECRET_KEY=civicguide-jwt-secret-key-2026-token

# Database Configuration (Defaults to SQLite; for PostgreSQL use postgresql://user:password@localhost:5432/civicguide)
DATABASE_URL=sqlite:///database/civicguide.db

# Email OTP Service Configuration (Gmail SMTP or any standard SMTP provider)
# If SMTP_USERNAME is empty or DEV_MODE_MOCK_EMAIL=True, OTPs are safely logged to console
# and stored in database/dev_otp_inbox.json so local testing is 100% functional without an email key.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
DEV_MODE_MOCK_EMAIL=True

# OTP Policies (Compulsory registration verification)
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Ollama Local AI Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Administrator Account Initial Configuration
ADMIN_FULL_NAME=District Administrator Vijayanagara
ADMIN_EMAIL=admin@civicguide.gov.in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@CivicGuide2026
